# Docker Compose settings (copy ke .env). Setting aplikasi ada di backend/.env & frontend/.env.local;
# nilai DB/CORS/API URL di bawah meng-override file tersebut saat jalan di Docker.

# Port host (default dipilih agar tidak bentrok dengan project lain: 3000/8000/5432 dipakai krl-app)
FRONTEND_PORT=3020
BACKEND_PORT=8020
DB_FORWARD_PORT=5442

# Set ke 0.0.0.0 supaya API bisa diakses dari HP / emulator (versi mobile)
BACKEND_BIND=127.0.0.1

# PostgreSQL
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=secret

# Jalankan container sebagai user WSL agar vendor/ dan node_modules/ tetap bisa diedit. Cek dengan `id`.
UID=1000
GID=1000
